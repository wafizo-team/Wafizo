# Copier ce fichier en terraform.tfvars et remplir les valeurs réelles
# NE JAMAIS committer terraform.tfvars

ovh_endpoint           = "ovh-eu"
ovh_application_key    = "VOTRE_APP_KEY"
ovh_application_secret = "VOTRE_APP_SECRET"
ovh_consumer_key       = "VOTRE_CONSUMER_KEY"
ovh_service_name       = "VOTRE_SERVICE_NAME"

openstack_user         = "user-xxxxxxxxxx"
openstack_password     = "VOTRE_MOT_DE_PASSE_OPENSTACK"
openstack_tenant_name  = "NOM_DE_VOTRE_PROJET_PUBLIC_CLOUD"
openstack_region       = "GRA11"

instance_name          = "wafizo-prod"
instance_flavor        = "b3-8"
instance_image         = "Debian 12"
ssh_public_key_path    = "~/.ssh/id_ed25519.pub"
ssh_key_name           = "wafizo-key"

domain_wafizo_fr       = "wafizo.fr"
domain_wafizo_com      = "wafizo.com"
